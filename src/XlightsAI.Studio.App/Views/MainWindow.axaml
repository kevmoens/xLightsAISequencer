<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XlightsAI.Studio.Shell"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:views="using:XlightsAI.Studio.App.Views"
        xmlns:screens="using:XlightsAI.Studio.App.Views.Screens"
        x:Class="XlightsAI.Studio.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="xLights AI Choreography Studio"
        Width="1180" Height="760"
        MinWidth="860" MinHeight="560">

  <!--
    The shell. It owns three things and nothing else: the startup states, the navigation rail, and
    which screen is mounted. Every screen's markup lives in its own file under Views/Screens.

    This file was previously 578 lines holding all eight screens as sibling StackPanels in one Grid
    cell, each toggled by its own IsVisible binding — so every screen's controls were constructed
    and laid out at all times, a change to the Audio screen risked the Timeline, and finding the
    markup for any one screen meant scrolling past the other seven. Screens keep binding against
    ShellViewModel (each UserControl declares x:DataType="vm:ShellViewModel" and inherits this
    window's DataContext), so no binding path changed in the split.

    PHASE-04 Step 029: Window-level keyboard shortcuts for the Timeline screen's navigation, zoom
    and loop actions. Each command's own CanExecute guard (Timeline.IsLoaded, a real selection, and
    so on) already makes every one of these a safe no-op on another screen or before its
    precondition holds, so one Window-level binding list needs no per-screen scoping.
  -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Right" Command="{Binding TimelineSelectNextEffectCommand}" />
    <KeyBinding Gesture="Left" Command="{Binding TimelineSelectPreviousEffectCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding TimelineClearSelectionCommand}" />
    <KeyBinding Gesture="OemPlus" Command="{Binding TimelineZoomInCommand}" />
    <KeyBinding Gesture="OemMinus" Command="{Binding TimelineZoomOutCommand}" />
    <KeyBinding Gesture="Z" Command="{Binding TimelineZoomToSelectionCommand}" />
    <KeyBinding Gesture="L" Command="{Binding SetTimelineLoopFromSelectionCommand}" />
    <KeyBinding Gesture="Shift+L" Command="{Binding ClearTimelineLoopCommand}" />
  </Window.KeyBindings>

  <Panel>

    <!-- ===== Startup ===== -->
    <StackPanel IsVisible="{Binding IsStarting}" Spacing="8"
                HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Classes="page-title" Text="Starting…" HorizontalAlignment="Center" />
    </StackPanel>

    <!-- Startup failure: never a blank window. -->
    <Border IsVisible="{Binding IsFailed}" Classes="card" Margin="40"
            MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="8">
        <TextBlock Classes="page-title" Foreground="{DynamicResource AppDangerBrush}" Text="Startup failed" />
        <TextBlock Text="{Binding Failure.Message}" TextWrapping="Wrap" />
        <TextBlock Classes="detail" Text="{Binding Failure.Code, StringFormat='Code: {0}'}" />
      </StackPanel>
    </Border>

    <!--
      First-run onboarding is a takeover, not a destination: while it is showing there is no
      navigation rail to wander off into, because nothing else in the app works until a workspace
      folder has been chosen. It used to be a button in the main nav bar sitting between
      "Diagnostics" and the timeline.
    -->
    <ScrollViewer IsVisible="{Binding IsShowingFirstRun}" VerticalScrollBarVisibility="Auto" Padding="32,28">
      <screens:FirstRunView />
    </ScrollViewer>

    <!-- ===== Ready ===== -->
    <Grid ColumnDefinitions="210,*">
      <Grid.IsVisible>
        <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
          <Binding Path="!IsStarting" />
          <Binding Path="!IsFailed" />
          <Binding Path="!IsShowingFirstRun" />
        </MultiBinding>
      </Grid.IsVisible>

      <views:ShellNavigationView Grid.Column="0" />

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,24">
        <Panel>
          <screens:WelcomeView IsVisible="{Binding IsShowingWelcome}" />
          <screens:ProjectsView IsVisible="{Binding IsShowingProjects}" />
          <screens:ShowImportView IsVisible="{Binding IsShowingShowImport}" />
          <screens:AudioView IsVisible="{Binding IsShowingAudio}" />
          <screens:GenerateExportView IsVisible="{Binding IsShowingGenerateExport}" />
          <screens:TimelineView IsVisible="{Binding IsShowingTimeline}" />
          <screens:SettingsView IsVisible="{Binding IsShowingSettings}" />
          <screens:DiagnosticsView IsVisible="{Binding IsShowingDiagnostics}" />

          <screens:PianoRollView IsVisible="{Binding IsShowingPianoRoll}" />
          <screens:StructureInspectorView IsVisible="{Binding IsShowingStructureInspector}" />
          <screens:DisplayPathEditorView IsVisible="{Binding IsShowingDisplayPathEditor}" />
        </Panel>
      </ScrollViewer>
    </Grid>
  </Panel>
</Window>
