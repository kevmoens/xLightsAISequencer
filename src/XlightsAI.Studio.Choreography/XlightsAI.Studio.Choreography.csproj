<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <WarningsAsErrors>Nullable</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-plan Phase 4 (architecture section 4/6/7): the deterministic constraint engine and the
         Look to ChoreographyIR compiler. Needs real geometry/recipes/palettes/timing tracks (Xlights),
         the generated effect vocabulary for legality checks (Knowledge), and the real analysis types a
         section's music data is built from (Rhythm/Structure/Stems) all at once. Mirrors Pipeline's own
         "none of these depend on each other, so the orchestrator must" rationale, but this project is
         itself a pure compiler library (no I/O), which is why it sits beside Pipeline rather than
         inside it. -->
    <ProjectReference Include="..\XlightsAI.Studio.Contracts\XlightsAI.Studio.Contracts.csproj" />
    <ProjectReference Include="..\XlightsAI.Studio.Xlights\XlightsAI.Studio.Xlights.csproj" />
    <ProjectReference Include="..\XlightsAI.Studio.Knowledge\XlightsAI.Studio.Knowledge.csproj" />
    <ProjectReference Include="..\XlightsAI.Studio.Rhythm\XlightsAI.Studio.Rhythm.csproj" />
    <ProjectReference Include="..\XlightsAI.Studio.Structure\XlightsAI.Studio.Structure.csproj" />
    <ProjectReference Include="..\XlightsAI.Studio.Stems\XlightsAI.Studio.Stems.csproj" />
    <!-- Build-plan Phase 18 §3 (Phase B): the real headless render pipeline (RenderPipeline,
         XlightsRenderAdapter, XlightsRenderCapabilityProbe, FseqRenderedFrameDecoder) EffectFixtureRenderer
         reuses verbatim, never a second render implementation. Rendering itself depends only on
         Contracts, Xlights, and Display, so this does not introduce a cycle. -->
    <ProjectReference Include="..\XlightsAI.Studio.Rendering\XlightsAI.Studio.Rendering.csproj" />
    <!-- Build-plan Phase 18 §4/5 follow-up: audio-reactive effects (Music/VU Meter/Guitar) rendered
         completely dark because the synthetic show never carried a real media file for xLights' own
         real-time audio analysis to read. DeterministicSyntheticAudioGenerator (a pure, license-free sine
         synthesizer, no copyrighted recording involved) already exists for exactly this "real but
         synthetic audio fixture" need; this is a leaf project (no references of its own), so depending on
         it here cannot introduce a cycle. -->
    <ProjectReference Include="..\XlightsAI.Studio.Reference\XlightsAI.Studio.Reference.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
