<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <WarningsAsErrors>Nullable</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XlightsAI.Studio.Contracts\XlightsAI.Studio.Contracts.csproj" />
    <!-- PHASE-12 Step 079: LoopRun persists an EditScope (PHASE-03's already-accepted scope/lock
         contract) as the bounded refinement run's own permitted time/model boundary. Editing does
         not reference Refinement (verified before adding), so this is not a cyclic reference. -->
    <ProjectReference Include="..\XlightsAI.Studio.Editing\XlightsAI.Studio.Editing.csproj" />
    <!-- PHASE-12 Step 080: LoopRun.GestureFamily/CandidateAttempt.Gestures reuse PHASE-10's own
         already-accepted TransitionKind/TransitionGesture contracts rather than inventing a parallel
         "gesture family" shape. Composition does not reference Refinement (verified before adding), so
         this is not a cyclic reference. -->
    <ProjectReference Include="..\XlightsAI.Studio.Composition\XlightsAI.Studio.Composition.csproj" />
    <!-- PHASE-12 Step 081: the "timing"/"melodic alignment" soft metrics read PHASE-05's own already-
         accepted BeatGrid and PHASE-07's own already-accepted MelodyTrack when supplied via
         ChoreographyQualityContext. The "legal effects" hard gate reads PHASE-03's own already-accepted
         EffectInstance.Locked bit. None of Rhythm/Melody/Xlights reference Refinement (verified before
         adding), so none of these are cyclic references. -->
    <ProjectReference Include="..\XlightsAI.Studio.Rhythm\XlightsAI.Studio.Rhythm.csproj" />
    <ProjectReference Include="..\XlightsAI.Studio.Melody\XlightsAI.Studio.Melody.csproj" />
    <ProjectReference Include="..\XlightsAI.Studio.Xlights\XlightsAI.Studio.Xlights.csproj" />
    <!-- PHASE-13 Step 089: the render/evaluation gate reuses PHASE-13's own already-accepted
         ILocalPreviewRenderer/IDisplayMetricsCalculator (Steps 085/088) and PHASE-09's own already-
         accepted SpatialDisplayGraph layout rather than inventing a parallel render/geometry contract.
         Neither Rendering nor Display references Refinement (verified before adding), so neither is a
         cyclic reference. -->
    <ProjectReference Include="..\XlightsAI.Studio.Rendering\XlightsAI.Studio.Rendering.csproj" />
    <ProjectReference Include="..\XlightsAI.Studio.Display\XlightsAI.Studio.Display.csproj" />
  </ItemGroup>

</Project>
