<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    One-off manual runner (not part of XlightsAI.Studio.slnx): drives a real, end-to-end
    AiChoreographyWholeSongGenerator run against a real song, a real local show layout and a real
    local Ollama model, and exports the result to a real .xsq file. Kept under tools/ as a reusable
    manual smoke-test, mirroring tools/CorpusMiner's own standalone-tool shape.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\XlightsAI.Studio.Shell\XlightsAI.Studio.Shell.csproj" />
    <ProjectReference Include="..\..\src\XlightsAI.Studio.Xlights\XlightsAI.Studio.Xlights.csproj" />
    <ProjectReference Include="..\..\src\XlightsAI.Studio.Director\XlightsAI.Studio.Director.csproj" />
    <ProjectReference Include="..\..\src\XlightsAI.Studio.Pipeline\XlightsAI.Studio.Pipeline.csproj" />
    <ProjectReference Include="..\..\src\XlightsAI.Studio.Audio\XlightsAI.Studio.Audio.csproj" />
    <ProjectReference Include="..\..\src\XlightsAI.Studio.Structure\XlightsAI.Studio.Structure.csproj" />
    <ProjectReference Include="..\..\src\XlightsAI.Studio.Stems\XlightsAI.Studio.Stems.csproj" />
    <ProjectReference Include="..\..\src\XlightsAI.Studio.Rhythm\XlightsAI.Studio.Rhythm.csproj" />
    <ProjectReference Include="..\..\src\XlightsAI.Studio.Melody\XlightsAI.Studio.Melody.csproj" />
    <ProjectReference Include="..\..\src\XlightsAI.Studio.AiEdits\XlightsAI.Studio.AiEdits.csproj" />
    <ProjectReference Include="..\..\src\XlightsAI.Studio.Distribution\XlightsAI.Studio.Distribution.csproj" />
  </ItemGroup>

</Project>
